namespace osi;

struct Vector3d {
    x: double;
    y: double;
    z: double;
}

table Timestamp {
    seconds: int64;
    nanos: int32;
}

table BaseMoving {
    position: Vector3d;
    velocity: Vector3d;
    orientation: Vector3d;
}

enum ObjectType : byte {
    TYPE_UNKNOWN = 0,
    TYPE_VEHICLE = 1,
    TYPE_PEDESTRIAN = 2,
    TYPE_ANIMAL = 3
}

table MovingObject {
    id: uint64;
    base: BaseMoving;
    type: ObjectType;
}

table SensorViewMessage {
    timestamp: Timestamp;
    sensor_id: uint64;
    moving_object: [MovingObject];
    sensor_name: string;
    is_valid: bool;
}

root_type SensorViewMessage;
