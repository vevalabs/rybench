namespace benchmark;

attribute "mtl";

// bounded response between q and r — future fragment (u=100, l=0)
table Event (mtl: "always[0,inf] ((q and ((not r) and eventually[0,10] r)) implies (p implies (((not r) until[0,10] s) until[0,10] r)))") {
  timestamp:ulong;
  p:bool;
  q:bool;
  r:bool;
  s:bool;
}

root_type Event;
