namespace benchmark;

attribute "mtl";

// bounded recurrence between q and r — future fragment (u=100, l=0)
table Event (mtl: "always[0,inf] ((q and ((not r) and eventually[0,10] r)) implies ((eventually[0,10] (p or r)) until[0,10] r))") {
  timestamp:ulong;
  p:bool;
  q:bool;
  r:bool;
}

root_type Event;
